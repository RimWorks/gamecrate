#!/usr/bin/env sh
set -e

echo "pre-push: lint"
bun run lint

echo "pre-push: typecheck"
bun run --silent build
bun run typecheck

echo "pre-push: docs"
bun run docs:check

echo "pre-push: test"
bun test --parallel

if command -v vale >/dev/null 2>&1; then
  if [ -d Styles/Google ]; then
    echo "pre-push: vale"
    vale .
  else
    echo "pre-push: vale skipped, run 'vale sync' once to fetch Styles/Google"
  fi
else
  echo "pre-push: vale skipped, not installed"
fi
