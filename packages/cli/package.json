{
  "name": "@gamecrate/cli",
  "version": "0.0.0-dev",
  "description": "Run a modded game in a container, with mods resolved from your local checkouts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RimWorks/gamecrate.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/RimWorks/gamecrate#readme",
  "bugs": "https://github.com/RimWorks/gamecrate/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gamecrate": "./dist/gamecrate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "types": "./dist/types/lib.d.ts",
  "files": [
    "dist/gamecrate.js",
    "dist/lib.js",
    "dist/types"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "docs": "bun scripts/gen-docs.ts",
    "docs:check": "bun scripts/gen-docs.ts --check",
    "test": "bun test --parallel",
    "build": "bun run build:node && bun run build:types && bun run build:binary",
    "build:node": "bun build ./src/index.ts --target=node --packages=external --define __VERSION__='\"'${npm_package_version:-0.0.0-dev}'\"' --outfile dist/gamecrate.js && bun build ./src/lib.ts --target=node --packages=external --outfile dist/lib.js",
    "build:types": "tsc -p tsconfig.build.json && bun scripts/dts-extensions.ts",
    "build:binary": "bun build ./src/index.ts --compile --define __VERSION__='\"'${npm_package_version:-0.0.0-dev}'\"' --outfile dist/gamecrate",
    "prepare": "bun run build:node && bun run build:types",
    "prepack": "bun run build:node && bun run build:types"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ansis": "^4.4.0",
    "commander": "15.0.0",
    "jsonc-parser": "3.3.1",
    "picomatch": "^4.0.2",
    "resolve.exports": "^2.0.3",
    "yaml": "^2.7.0",
    "zod": "4.6.5"
  }
}
