{
  "name": "@gamecrate/rimworld",
  "version": "0.0.0-dev",
  "description": "RimWorld plugin for gamecrate: About.xml, ModsConfig.xml and Prefs.xml.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RimWorks/gamecrate.git",
    "directory": "packages/rimworld"
  },
  "homepage": "https://github.com/RimWorks/gamecrate/tree/main/packages/rimworld#readme",
  "bugs": "https://github.com/RimWorks/gamecrate/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel",
    "build": "npm run build:node && npm run build:types",
    "build:node": "bun build ./src/index.ts --target=node --outfile dist/index.js",
    "build:types": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "saxes": "^6.0.0",
    "xmlchars": "^2.2.0"
  },
  "devDependencies": {
    "@gamecrate/cli": "*",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
