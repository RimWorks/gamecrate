{
  "name": "gamecrate-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test --parallel=$(ls packages/*/test/*.test.ts | wc -l)",
    "build": "bun run --filter @gamecrate/cli build && bun run --filter @gamecrate/rimworld build",
    "docs": "bun run --filter @gamecrate/cli docs",
    "docs:check": "bun run --filter @gamecrate/cli docs:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxlint": "1.86.0"
  }
}
